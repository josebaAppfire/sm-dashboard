JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=
BOARD_ID=123
# Teams for the burnup selector: Name:BoardId, comma-separated.
# The name must appear as a word in your Jira sprint titles.
# If empty, BOARD_ID is used and the team selector is hidden.
BURNUP_TEAMS=TeamA:123,TeamB:456
SPRINT_ID=1000
ESTIMATE_FIELD=customfield_10016
PORT=3001
