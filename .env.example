JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=
BOARD_ID=123
# Equipos para el selector del burnup: Nombre:BoardId separados por comas.
# El nombre debe aparecer como palabra en el título de los sprints de Jira.
# Si se deja vacío, se usa BOARD_ID sin selector de equipo.
BURNUP_TEAMS=TeamA:123,TeamB:456
SPRINT_ID=1000
ESTIMATE_FIELD=customfield_10016
PORT=3001
